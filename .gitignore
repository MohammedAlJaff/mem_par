# Local paths and configs (per-machine)
**/paths.local.yaml
**/paths.local.yml
.claude/settings.local.json
.claude/scheduled-tasks.json

# Experiment outputs and runs (large, per-machine)
**/runs/*
!**/runs/.gitkeep
output/
outputs/

# Paper figure metric snapshots. Keep only compact top-level CSV/JSONL files
# needed to regenerate paper figures; leave PNGs, caches, checkpoints, and
# per-attempt eval outputs ignored.
!outputs/
outputs/*
!outputs/evals/
outputs/evals/*
!outputs/evals/mem_boundary_20260427_all_done_quality_20260501/
outputs/evals/mem_boundary_20260427_all_done_quality_20260501/*
